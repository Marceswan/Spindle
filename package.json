{
  "name": "sfdx-graph-mcp",
  "version": "1.2.0",
  "description": "Local-first MCP server that indexes SFDX projects into a queryable metadata graph",
  "license": "MIT",
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "sfdx-graph-mcp": "bin/sfdx-graph-mcp"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000",
    "build": "bun build src/cli.ts --compile --outfile dist/sfdx-graph-mcp",
    "start": "bun run src/cli.ts",
    "bench": "SFDX_GRAPH_LOG_LEVEL=silent bun run bench/cli.ts"
  },
  "dependencies": {
    "@apexdevtools/apex-parser": "^4.4.0",
    "@apexdevtools/vf-parser": "1.1.0",
    "@babel/parser": "^7.26.0",
    "@lwc/metadata": "15.0.5",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chokidar": "^4.0.0",
    "commander": "^12.0.0",
    "fast-xml-parser": "^4.5.0",
    "parse5": "^7.2.0",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
