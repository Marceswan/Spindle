<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Email_Required</fullName>
    <active>true</active>
    <description>Email must be present when Tier is Gold.</description>
    <errorConditionFormula>AND(ISPICKVAL(Tier__c, "Gold"), ISBLANK(Email__c))</errorConditionFormula>
    <errorDisplayField>Email__c</errorDisplayField>
    <errorMessage>Gold customers must have an Email.</errorMessage>
</ValidationRule>
