    <type>RecordPage</type>
    <sobjectType>Customer__c</sobjectType>
    <flexiPageRegions>
        <name>main</name>
        <type>Region</type>
        <itemInstances>
            <componentInstance>
                <componentName>c:customerCard</componentName>
                <componentInstanceProperties>
                    <name>recordId</name>
                    <value>{!recordId}</value>
                </componentInstanceProperties>
            </componentInstance>
        </itemInstances>
        <itemInstances>
            <fieldInstance>
                <fieldItem>Record.Email__c</fieldItem>
                <uiBehavior>Edit</uiBehavior>
            </fieldInstance>
        </itemInstances>
        <itemInstances>
            <fieldInstance>
                <fieldItem>Record.Tier__c</fieldItem>
                <uiBehavior>Readonly</uiBehavior>
            </fieldInstance>
        </itemInstances>
    </flexiPageRegions>
</FlexiPage>
